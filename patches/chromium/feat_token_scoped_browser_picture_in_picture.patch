+bool MediaSessionController::OnEnterBrowserPictureInPicture(
+    int player_id, const std::string& token) {
+  CHECK_EQ(player_id_, player_id, base::NotFatalUntil::M160);
+  auto* observer = web_contents_->media_web_contents_observer();
+  if (!observer->IsMediaPlayerRemoteAvailable(id_)) return false;
+  observer->GetMediaPlayerRemote(id_)->RequestEnterBrowserPictureInPicture(token);
+  return true;
+}
