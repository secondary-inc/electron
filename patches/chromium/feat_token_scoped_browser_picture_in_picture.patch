+    StartSessionCallback callback) {
+  auto document = render_frame_host().GetWeakDocumentPtr();
+  auto* contents = WebContents::FromRenderFrameHost(&render_frame_host());
+  auto* delegate = contents ? contents->GetDelegate() : nullptr;
+  const bool allowed = delegate
+      ? delegate->CanStartBrowserPictureInPicture(&render_frame_host(), request_token)
+      : request_token.empty();
+  if (!allowed || !document.AsRenderFrameHostIfValid()) {
+    std::move(callback).Run({}, {});
+    return;
+  }
