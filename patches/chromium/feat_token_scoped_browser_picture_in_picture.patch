+void PictureInPictureServiceImpl::StartBrowserSession(
+    const std::string& request_token,
+    uint32_t player_id,
+    mojo::PendingAssociatedRemote<media::mojom::MediaPlayer> player_remote,
+    const viz::SurfaceId& surface_id,
+    const gfx::Size& natural_size,
+    bool show_play_pause_button,
+    mojo::PendingRemote<blink::mojom::PictureInPictureSessionObserver> observer,
+    const gfx::Rect& source_bounds,
+    StartBrowserSessionCallback callback) {
+  if (request_token.empty() || request_token.size() > 128) {
+    std::move(callback).Run({}, {});
+    return;
+  }
+  StartSessionInternal(request_token, player_id, std::move(player_remote),
+      surface_id, natural_size, show_play_pause_button, std::move(observer),
+      source_bounds, nullptr, std::move(callback));
+}
