+bool MediaSessionImpl::CanEnterBrowserPictureInPicture() const {
+  // Explicitly approved embedder behavior, not a global feature-flag override.
+  // Do not commandeer a site's own PiP media-session handler.
+  if (!IsPictureInPictureAvailable() ||
+      IsActivelyUsingCameraOrMicrophone() || normal_players_.size() != 1u ||
+      (routed_service_ && routed_service_->actions().contains(
+          media_session::mojom::MediaSessionAction::kEnterPictureInPicture)))
+    return false;
+  auto& player = normal_players_.begin()->first;
+  auto* frame = player.observer->render_frame_host();
+  if (!frame || !frame->IsInPrimaryMainFrame() ||
+      player.observer->IsPaused(player.player_id))
+    return false;
+  return true;
+}
+
+bool MediaSessionImpl::RequestBrowserPictureInPicture(const std::string& token) {
+  if (token.empty() || token.size() > 128 || !CanEnterBrowserPictureInPicture())
+    return false;
+  auto& player = normal_players_.begin()->first;
+  return player.observer->OnEnterBrowserPictureInPicture(player.player_id, token);
+}
