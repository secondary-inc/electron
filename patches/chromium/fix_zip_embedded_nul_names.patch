From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iris <dev@iris.local>
Subject: Reject embedded NUL ZIP names before C-string truncation

CRX staging must reject malformed paths rather than extract a truncated name.
Keep Chromium 156's separate physical and Unicode paths and reject either NUL.

diff --git a/third_party/zlib/google/zip_reader.cc b/third_party/zlib/google/zip_reader.cc
--- a/third_party/zlib/google/zip_reader.cc
+++ b/third_party/zlib/google/zip_reader.cc
@@ -308,2 +308,8 @@
+  if (info.size_filename >= path_in_zip.size() ||
+      std::string_view(path_in_zip.data(), info.size_filename).find('\0') !=
+          std::string_view::npos) {
+    LOG(ERROR) << "Invalid ZIP entry name";
+    return false;
+  }
   DCHECK(path_in_zip[info.size_filename] == '\0');
   entry_.path_in_original_encoding = path_in_zip.data();
@@ -338,2 +344,7 @@
+    if (std::string_view(info.utf8_filename, info.size_utf8_filename).find('\0') !=
+        std::string_view::npos) {
+      LOG(ERROR) << "Invalid ZIP Unicode entry name";
+      return false;
+    }
     DCHECK(info.utf8_filename[info.size_utf8_filename] == '\0');
     entry_.path_in_original_encoding = info.utf8_filename;
