From: 💔 <shah@priansh.com>
Subject: Use embedder tab identity for subframe injection permission checks

Electron's public tab IDs are WebContents IDs, not SessionTabHelper IDs.
Keep the normal permission check but resolve its tab-specific grant using the
embedder's identity, with the previous session helper as a fallback.

diff --git a/extensions/browser/script_executor.cc b/extensions/browser/script_executor.cc
--- a/extensions/browser/script_executor.cc
+++ b/extensions/browser/script_executor.cc
@@ -28,4 +28,5 @@
 #include "extensions/browser/extension_api_frame_id_map.h"
 #include "extensions/browser/extension_registry.h"
 #include "extensions/browser/extension_web_contents_observer.h"
+#include "extensions/browser/extensions_browser_client.h"
 #include "extensions/browser/script_injection_tracker.h"
@@ -117,4 +118,8 @@
       int tab_id = -1;
       if (host_id_.type == mojom::HostID::HostType::kExtensions) {
-        tab_id = sessions::SessionTabHelper::IdForTab(web_contents).id();
+        int window_id = -1;
+        ExtensionsBrowserClient::Get()->GetTabAndWindowIdForWebContents(
+            web_contents, &tab_id, &window_id);
+        if (tab_id < 0)
+          tab_id = sessions::SessionTabHelper::IdForTab(web_contents).id();
       }
