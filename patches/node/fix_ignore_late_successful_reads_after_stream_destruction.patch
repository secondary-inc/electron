From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iris Maintainers <dev@2nd.inc>
Date: Sat, 7 Nov 2026 19:10:00 -0500
Subject: fix: ignore late successful reads after stream destruction

A positive byte count on an already destroyed TCP socket fell through to
ErrnoException, causing ERR_OUT_OF_RANGE during Work browser shutdown.
Discard that data without suppressing real negative errors or EOF handling.

diff --git a/lib/internal/stream_base_commons.js b/lib/internal/stream_base_commons.js
--- a/lib/internal/stream_base_commons.js
+++ b/lib/internal/stream_base_commons.js
@@ -176,7 +176,10 @@ function onStreamRead(arrayBuffer) {
 
   stream[kUpdateTimer]();
 
-  if (nread > 0 && !stream.destroyed) {
+  if (nread > 0) {
+    // A pending successful read may arrive after socket destruction.
+    // Its byte count is not an errno and must never reach ErrnoException.
+    if (stream.destroyed) return;
     let ret;
     let result;
     const userBuf = stream[kBuffer];
