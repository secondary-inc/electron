From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iris <dev@iris.local>
Subject: Prepare the verified update copy before application exit

Preserve upstream interrupted-install recovery before preparing the update.

diff --git a/Squirrel/SQRLInstaller+Private.h b/Squirrel/SQRLInstaller+Private.h
index f813d98..8f30b80 100644
--- a/Squirrel/SQRLInstaller+Private.h
+++ b/Squirrel/SQRLInstaller+Private.h
@@ -18,6 +18,13 @@ extern NSString * const SQRLInstallerOwnedBundleKey;
 // made.
 extern NSString * const SQRLShipItInstallationAttemptsKey;
 
+@class SQRLShipItRequest;
+@interface SQRLInstaller (BackgroundPreparation)
+// Copies into installer-owned storage without modifying the running application.
+// Installation still validates the request and rechecks the copy's signature.
+- (RACSignal *)prepareUpdateWhileRunning:(SQRLShipItRequest *)request;
+@end
+
 @interface SQRLInstaller (Private)
 
 // Moves a bundle that an earlier, unfinished install left in the temporary
