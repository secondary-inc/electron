+++ b/Squirrel/SQRLInstaller.m
@@ -54,6 +54,8 @@ NSString * const SQRLInstallerOwnedBundleKey = @"SQRLInstallerOwnedBundle";
 // Stores the bundle moved aside by an install request so that the original
 // bundle can be restored to its original location if needed.
 @property (atomic, strong) SQRLInstallerOwnedBundle *ownedBundle;
+@property (atomic, strong) NSURL *preparedBundleURL;
+@property (atomic, strong) SQRLShipItRequest *preparedRequest;
 
 // Reads the given key from `request`, failing if it's not set.
 //
@@ -244,6 +246,41 @@ NSString * const SQRLInstallerOwnedBundleKey = @"SQRLInstallerOwnedBundle";
 
 #pragma mark Installer States
 
+- (RACSignal *)prepareUpdateWhileRunning:(SQRLShipItRequest *)request {
+	// Use only private temporary storage. Never rename or write the installed app.
+	return [[[self prepareAndValidateUpdateBundleURLForRequest:request]
+		doNext:^(NSURL *bundleURL) {
+			self.preparedBundleURL = bundleURL;
+			self.preparedRequest = request;
+			NSLog(@"Background update copy prepared");
+		}] ignoreValues];
+}
+
+- (RACSignal *)preparedUpdateForRequest:(SQRLShipItRequest *)request {
+	NSURL *bundleURL = self.preparedBundleURL;
+	SQRLShipItRequest *prepared = self.preparedRequest;
+	self.preparedBundleURL = nil;
+	self.preparedRequest = nil;
+	BOOL matches = bundleURL != nil &&
+		[prepared.updateBundleURL isEqual:request.updateBundleURL] &&
+		[prepared.targetBundleURL.URLByStandardizingPath.path isEqual:request.targetBundleURL.URLByStandardizingPath.path] &&
+		[prepared.bundleIdentifier isEqual:request.bundleIdentifier] &&
+		prepared.useUpdateBundleName == request.useUpdateBundleName;
+	if (!matches) {
+		if (bundleURL != nil) {
+			return [[[self deleteOwnedBundleAtURL:bundleURL] catchTo:[RACSignal empty]]
+				then:^{ return [self prepareAndValidateUpdateBundleURLForRequest:request]; }];
+		}
+		return [self prepareAndValidateUpdateBundleURLForRequest:request];
+	}
+	// The app may have stayed open for hours. Never trust the cached verification.
+	return [[self codeSignatureForBundleAtURL:request.targetBundleURL]
+		flattenMap:^(SQRLCodeSignature *signature) {
+			return [[[self verifyBundleAtURL:bundleURL usingSignature:signature]
+				ignoreValues] concat:[RACSignal return:bundleURL]];
+		}];
+}
+
 - (RACSignal *)prepareAndValidateUpdateBundleURLForRequest:(SQRLShipItRequest *)request {
 	NSParameterAssert(request != nil);
 
